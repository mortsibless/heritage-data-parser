  "ocr_artifacts": {
    "_note": "Populate after inspecting your local Akuapem PDF with --probe flag",
    "character_substitutions": {},
    "footnote_marker_pattern": "^[a-z]\\s+[A-Z]",
    "crossref_pattern": "[A-Z][a-z]+\\.\\s+\\d+[,\\s\\d:-]+"
  },

  "special_characters": {
    "twi_specific": ["ɛ", "ɔ", "ŋ"],
    "encoding": "UTF-8",
    "normalization": "NFC"
  },

  "extraction": {
    "page_header_regex": "^\\s*(\\d+)\\s+([A-ZÄÖÜ\\s\\.]+?)\\s+\\[([\\d,\\s\\-]+)\\]",
    "verse_inline_regex": "(?<![\\w])([1-9][0-9]{0,2})\\s+(?=[A-ZÄÖÜ\\wɛɔŋ])",
    "chapter_range_from_header": true,
    "skip_line_patterns": [
      "^\\s*\\d+\\s+[A-Z\\s]+\\s+\\[",
      "^[a-z]\\s+[A-Za-z]+\\.\\s+\\d+",
      "^\\s*[a-z]\\s*$",
      "^\\f",
      "^\\s{20,}[A-Z][a-z]"
    ]
